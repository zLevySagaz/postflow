# ===========================================
# PostFlow — Variáveis de ambiente (exemplo)
# Copie este arquivo para .env e preencha os valores.
# Nenhum segredo real deve ser commitado.
# ===========================================

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# --- Banco de dados (Prisma / PostgreSQL) ---
# Local: postgresql://user:password@localhost:5432/postflow
# Neon/Supabase: use a connection string fornecida pelo provedor
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/postflow"

# --- Autenticação (Auth.js) ---
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="gere-com: openssl rand -base64 32"

# --- Criptografia de tokens OAuth ---
# Chave usada para cifrar accessTokenEnc/refreshTokenEnc em SocialToken.
# NUNCA reutilize esta chave entre ambientes.
TOKEN_ENCRYPTION_KEY="gere-com: openssl rand -hex 32"

# --- Redis / BullMQ (filas e workers) ---
REDIS_URL="redis://localhost:6379"

# --- Storage (S3-compatible) ---
STORAGE_ENDPOINT=""
STORAGE_REGION=""
STORAGE_BUCKET="postflow-media"
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""

# --- Stripe (assinaturas) ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID_STARTER=""
STRIPE_PRICE_ID_PRO=""
STRIPE_PRICE_ID_AGENCY=""

# --- Integrações de redes sociais (OAuth) ---
# Preencha ao implementar cada provider em src/integrations/providers/*
INSTAGRAM_CLIENT_ID=""
INSTAGRAM_CLIENT_SECRET=""

FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""

X_CLIENT_ID=""
X_CLIENT_SECRET=""

TIKTOK_CLIENT_ID=""
TIKTOK_CLIENT_SECRET=""

YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""

# --- E-mail (notificações) ---
EMAIL_FROM="PostFlow <notificacoes@postflow.com>"
EMAIL_PROVIDER_API_KEY=""
